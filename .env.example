# Copy this file to .env and fill in values. .env is gitignored - never commit real keys.
# Every setting is optional. With no .env at all, the app runs in rules-only mode.

# Classifier: none | anthropic | openai
TRIAGE_LLM_PROVIDER=none

# Model name. Required for openai. For anthropic, defaults to claude-opus-5-5.
# TRIAGE_LLM_MODEL=

# Only the key for the provider you selected is needed.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Reliability settings for AI calls
TRIAGE_LLM_TIMEOUT_SECONDS=20
TRIAGE_LLM_MAX_ATTEMPTS=3

# Optional shared secret. If set, POST /intake requires header X-Webhook-Token.
# TRIAGE_WEBHOOK_TOKEN=

# File locations (relative to where you run the command)
TRIAGE_AUDIT_LOG=logs/audit.jsonl
# TRIAGE_RULES_PATH=config/triage_rules.json

# DEBUG | INFO | WARNING | ERROR
TRIAGE_LOG_LEVEL=INFO
